{
  "name": "braincraft",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build -c vite.mcp.config.ts && vite build -c vite.server.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint src",
    "check": "tsc -b && oxlint src && vitest run",
    "mcp": "node dist/braincraft-mcp.mjs",
    "serve": "node dist/braincraft-server.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4",
    "ws": "8.21.3"
  },
  "description": "An infinite whiteboard and mind-mapping tool for brainstorming with friends",
  "license": "MIT OR Apache-2.0",
  "bin": {
    "braincraft-mcp": "dist/braincraft-mcp.mjs",
    "braincraft-server": "dist/braincraft-server.mjs"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "katex": "0.19.0",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20",
      "sass": "1.105.2"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    }
  }
}
