{
  "name": "braincraft",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build -c vite.mcp.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint src",
    "check": "tsc -b && oxlint src && vitest run",
    "mcp": "node dist/braincraft-mcp.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "description": "An infinite whiteboard and mind-mapping tool for brainstorming",
  "license": "MIT OR Apache-2.0",
  "bin": {
    "braincraft-mcp": "dist/braincraft-mcp.mjs"
  }
}
